{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@pinpoint/shared": ["packages/shared/src/index.ts"],
      "@pinpoint/shared/*": ["packages/shared/src/*"],
      "@pinpoint/ui": ["packages/ui/src/index.ts"],
      "@pinpoint/ui/*": ["packages/ui/src/*"]
    }
  }
}
