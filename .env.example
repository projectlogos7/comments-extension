# Public origin of the server (used in links, emails, OAuth redirect URIs)
PUBLIC_URL=http://localhost:8787
PORT=8787
# Long random string. Signs access tokens, file URLs and OAuth state.
JWT_SECRET=change-me
# Postgres. Leave empty to use the embedded PGlite database in DATA_DIR.
DATABASE_URL=
DATA_DIR=./data
# Email. Leave empty to print emails to the console (dev mailbox at /dev/mailbox when DEV_LOGIN=1).
SMTP_URL=
MAIL_FROM="Pinpoint <no-reply@example.com>"
# OAuth (redirect URIs: $PUBLIC_URL/api/v1/auth/google/callback and /microsoft/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Snapshot storage: local | s3
STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Comma-separated extension IDs allowed to talk to the share viewer
EXTENSION_IDS=
# Enables /auth/dev-login and the dev mailbox. Never enable in production.
DEV_LOGIN=0
